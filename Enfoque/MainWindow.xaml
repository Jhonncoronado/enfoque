<Window x:Class="Enfoque.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enfoque" Height="640" Width="580"
        MinHeight="600" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Enfoque" FontSize="30" FontWeight="SemiBold" Foreground="#1F2937" />
        <TextBlock Grid.Row="1" Margin="0,6,0,24" Text="Resalta la ventana activa y oscurece el resto de la pantalla."
                   Foreground="#5B6472" FontSize="14" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Nivel de oscuridad" FontWeight="SemiBold" Foreground="#273142" />
            <Slider x:Name="OpacitySlider" Margin="0,10,0,4" Minimum="0.15" Maximum="0.90" Value="0.70"
                    TickFrequency="0.05" IsSnapToTickEnabled="True" />
            <Grid>
                <TextBlock Text="15%" Foreground="#687386" />
                <TextBlock Text="90%" HorizontalAlignment="Right" Foreground="#687386" />
            </Grid>
            <TextBlock Margin="0,20,0,6" Text="Monitor donde aplicar el enfoque"
                       FontWeight="SemiBold" Foreground="#273142" />
            <ComboBox x:Name="MonitorComboBox" DisplayMemberPath="DisplayName" Height="30" />
            <TextBlock Margin="0,14,0,6" Text="Forma del área" FontWeight="SemiBold" Foreground="#273142" />
            <ComboBox x:Name="ShapeComboBox" Height="30" SelectedIndex="0">
                <ComboBoxItem Tag="Rectangle">Rectángulo</ComboBoxItem>
                <ComboBoxItem Tag="Square">Cuadrado</ComboBoxItem>
                <ComboBoxItem Tag="Circle">Círculo</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="TrackRelatedWindowsCheckBox" Margin="0,14,0,0"
                      Content="Seguir modales, popups y ventanas nuevas"
                      Foreground="#273142" IsChecked="True" />
            <CheckBox x:Name="CaptureAnyPopupCheckBox" Margin="0,7,0,0"
                      Content="Capturar popups aunque sean de otro proceso"
                      Foreground="#5B6472" IsChecked="True" />
            <Separator Margin="0,22,0,12" />
            <TextBlock Text="Atajos globales" FontWeight="SemiBold" Foreground="#273142" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Activar / desactivar enfoque" VerticalAlignment="Center"
                           Foreground="#5B6472" />
                <TextBox x:Name="ActivateHotkeyTextBox" Grid.Column="1" Text="Ctrl + Alt + F"
                         IsReadOnly="True" ToolTip="Haga clic y presione la combinación deseada"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cerrar aplicación" VerticalAlignment="Center"
                           Foreground="#5B6472" />
                <TextBox x:Name="ExitHotkeyTextBox" Grid.Column="1" Text="Ctrl + X"
                         IsReadOnly="True" ToolTip="Haga clic y presione la combinación deseada"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
            </Grid>
            <TextBlock Margin="0,8,0,0" Text="Haga clic en un campo y presione Ctrl, Alt, Shift o Windows junto con una tecla."
                       Foreground="#687386" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="StartButton" Content="Activar enfoque" Click="StartButton_Click"
                    Padding="18,10" Background="#2563EB" Foreground="White" BorderThickness="0" />
            <Button x:Name="DrawAreaButton" Content="Dibujar áreas" Click="DrawAreaButton_Click"
                    Padding="18,10" Margin="10,0,0,0" />
            <Button x:Name="StopButton" Content="Desactivar" Click="StopButton_Click"
                    Padding="18,10" Margin="10,0,0,0" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
