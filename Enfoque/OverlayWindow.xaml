<Window x:Class="Enfoque.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize">
    <Canvas x:Name="MaskCanvas" Background="Transparent">
        <Image x:Name="ObfuscationImage" Stretch="Fill"
               Visibility="Collapsed" IsHitTestVisible="False" />
        <MediaElement x:Name="ObfuscationVideo" Stretch="Fill"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Visibility="Collapsed" IsHitTestVisible="False"
                      MediaEnded="ObfuscationVideo_MediaEnded" />
        <Path x:Name="MaskPath" />
        <Rectangle x:Name="PauseMask" Fill="Black" Visibility="Collapsed"
                   IsHitTestVisible="False" />
    </Canvas>
</Window>
