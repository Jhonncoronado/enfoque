<Window x:Class="Enfoque.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" Width="48" Height="52"
        MouseEnter="ControlPanelWindow_MouseEnter">
    <Grid>
        <Button x:Name="ToggleButton" Content="☰" Width="48" Height="52"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                FontSize="22" Foreground="White" Background="#DC1F2937"
                BorderThickness="0" ToolTip="Abrir opciones" Click="ToggleButton_Click" />

        <Border x:Name="QuickBar" Visibility="Collapsed" Margin="48,0,0,0"
                Background="#EC1F2937" CornerRadius="0,6,6,0" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PauseButton" Content="⏸" Width="42" Height="42"
                        FontSize="18" Foreground="White" Background="Transparent"
                        BorderThickness="0" ToolTip="Pausar" Click="PauseButton_Click" />
                <Button x:Name="StopButton" Content="■" Width="42" Height="42"
                        FontSize="16" Foreground="#FCA5A5" Background="Transparent"
                        BorderThickness="0" ToolTip="Detener enfoque" Click="StopButton_Click" />
                <Border x:Name="DragHandle" Width="28" Height="42" Cursor="SizeNS"
                        Background="#334B5563" ToolTip="Arrastrar hacia arriba o abajo"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <TextBlock Text="⋮" Foreground="White" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="SettingsPanel" Visibility="Collapsed" Margin="48,0,0,0"
                Width="340" Background="#F4F6F8" BorderBrush="#CBD5E1" BorderThickness="1"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Opciones de enfoque" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1F2937" />
                    <TextBlock Text="Oscurecimiento" Margin="0,16,0,4" Foreground="#374151" />
                    <Slider x:Name="DarknessSlider" Minimum="0.15" Maximum="0.90" Value="0.55"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="DarknessSlider_ValueChanged" />
                    <TextBlock x:Name="DarknessLabel" Text="55%" HorizontalAlignment="Right"
                               Foreground="#64748B" />

                    <Separator Margin="0,12,0,4" />
                    <CheckBox x:Name="FollowMouseCheckBox" Content="Seguir el mouse"
                              FontWeight="SemiBold" Foreground="#374151"
                              Checked="FollowMouseCheckBox_Changed"
                              Unchecked="FollowMouseCheckBox_Changed" />
                    <TextBlock Text="Forma del seguimiento" Margin="0,8,0,4" Foreground="#374151" />
                    <ComboBox x:Name="FollowShapeComboBox" Height="28"
                              SelectionChanged="FollowShapeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Rectangle">Rectangulo</ComboBoxItem>
                        <ComboBoxItem Tag="Square">Cuadrado</ComboBoxItem>
                        <ComboBoxItem Tag="Circle">Circulo</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Tamano del seguimiento" Margin="0,8,0,4" Foreground="#374151" />
                    <Slider x:Name="FollowSizeSlider" Minimum="80" Maximum="800" Value="280"
                            TickFrequency="20" IsSnapToTickEnabled="True"
                            ValueChanged="FollowSizeSlider_ValueChanged" />
                    <TextBlock x:Name="FollowSizeLabel" Text="280 px" HorizontalAlignment="Right"
                               Foreground="#64748B" />

                    <Button Content="+ Agregar area" Margin="0,16,0,0" Padding="8,7"
                            Click="AddAreaButton_Click" />
                    <TextBlock Text="Areas enfocadas" Margin="0,16,0,5" FontWeight="SemiBold"
                               Foreground="#374151" />

                    <Separator Margin="0,14,0,4" />
                    <TextBlock Text="Resaltado de texto especifico" FontSize="15"
                               FontWeight="SemiBold" Foreground="#1F2937" />
                    <CheckBox x:Name="SpecificTextCheckBox" Margin="0,8,0,0"
                              Content="Activar resaltado de texto"
                              Foreground="#374151" Checked="SpecificTextCheckBox_Changed"
                              Unchecked="SpecificTextCheckBox_Changed" />
                    <TextBox x:Name="SpecificTextBox" Margin="0,6,0,0" Height="54"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Escriba aqui el texto que desea buscar" />
                    <Button Content="Resaltar ahora" Margin="0,6,0,0" Padding="8,6"
                            Click="HighlightNowButton_Click" />
                    <ListBox x:Name="AreasList" Height="100" Margin="0,8,0,0" />
                    <Button Content="Editar seleccionada" Margin="0,6,0,0" Padding="8,6"
                            Click="EditAreaButton_Click" />
                    <Button Content="Eliminar seleccionada" Margin="0,6,0,0" Padding="8,6"
                            Click="RemoveAreaButton_Click" />
                    <Button Content="Limpiar todas" Margin="0,6,0,0" Padding="8,6"
                            Click="ClearAreasButton_Click" />
                    <Button Content="Cerrar panel" Margin="0,16,0,0" Padding="8,6"
                            Click="ToggleButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
